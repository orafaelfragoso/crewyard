{
  "name": "crewyard",
  "version": "0.4.1",
  "description": "Local-first coordination engine for independent AI coding agents.",
  "keywords": [
    "ai",
    "agents",
    "coding-agents",
    "mcp",
    "orchestration",
    "git",
    "worktrees",
    "merge-queue",
    "cli"
  ],
  "license": "MIT",
  "author": "Rafael Fragoso",
  "homepage": "https://github.com/orafaelfragoso/crewyard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orafaelfragoso/crewyard.git"
  },
  "bugs": {
    "url": "https://github.com/orafaelfragoso/crewyard/issues"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/providers/*",
    "apps/*"
  ],
  "bin": {
    "crew": "apps/cli/src/main.ts"
  },
  "scripts": {
    "crew": "bun apps/cli/src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:unit": "bun test tests/unit packages",
    "test:concurrency": "bun test tests/concurrency",
    "build:binaries": "bun scripts/build-binaries.ts",
    "build:npm": "bun scripts/npm-packages.ts",
    "sbom": "bun scripts/sbom.ts",
    "docs:cli": "bun scripts/gen-cli-reference.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "@crewyard/cli": "workspace:*",
    "@crewyard/mcp": "workspace:*",
    "@crewyard/agents": "workspace:*",
    "@crewyard/application": "workspace:*",
    "@crewyard/config": "workspace:*",
    "@crewyard/context": "workspace:*",
    "@crewyard/core": "workspace:*",
    "@crewyard/github": "workspace:*",
    "@crewyard/host-installers": "workspace:*",
    "@crewyard/indexing": "workspace:*",
    "@crewyard/integration": "workspace:*",
    "@crewyard/projects": "workspace:*",
    "@crewyard/provider-claude": "workspace:*",
    "@crewyard/provider-codex": "workspace:*",
    "@crewyard/provider-generic": "workspace:*",
    "@crewyard/provider-ollama": "workspace:*",
    "@crewyard/provider-opencode": "workspace:*",
    "@crewyard/recovery": "workspace:*",
    "@crewyard/reviews": "workspace:*",
    "@crewyard/scheduler": "workspace:*",
    "@crewyard/storage": "workspace:*",
    "@crewyard/tasks": "workspace:*",
    "@crewyard/telemetry": "workspace:*",
    "@crewyard/tui": "workspace:*",
    "@crewyard/workspaces": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
